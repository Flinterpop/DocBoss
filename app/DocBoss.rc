// Version resource and application icon.
//
// The version lives in lockstep in this file (string AND numeric forms),
// app/Version.h, CMakeLists.txt and installer.iss; tests/test_version.cpp
// fails the build if they drift.  Explorer's Details tab reads the STRING
// "FileVersion", installers compare the NUMERIC tuple -- updating one and not
// the other is the classic way to ship an installer that refuses to upgrade.

#include <windows.h>

// The application icon must be first by ordinal: Windows uses the
// LOWEST-numbered icon resource for the executable itself.
1 ICON "docboss.ico"

// The studio mark shown in the About box.
2 ICON "bungee.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,2,0
PRODUCTVERSION 1,0,2,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"          // US English, Unicode
        BEGIN
            VALUE "CompanyName",      "Flinterpop"
            VALUE "FileDescription",  "DocBoss - Markdown sources and their PDFs"
            VALUE "FileVersion",      "1.0.2"
            VALUE "InternalName",     "DocBoss"
            VALUE "LegalCopyright",   "AGPL-3.0-or-later"
            VALUE "OriginalFilename", "DocBoss.exe"
            VALUE "ProductName",      "DocBoss"
            VALUE "ProductVersion",   "1.0.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
