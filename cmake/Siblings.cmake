# ---- Forwarding headers ---------------------------------------------------

set(DOCBOSS_PULL_INCLUDE "${CMAKE_BINARY_DIR}/pull")

function(docboss_forward prefix app_dir units)
    foreach(_unit ${units})
        set(_target "${app_dir}/${_unit}.h")
        if(NOT EXISTS "${_target}")
            continue()   # a unit with no header of its own (UpdaterHttp)
        endif()
        set(_out "${DOCBOSS_PULL_INCLUDE}/${prefix}/${_unit}.h")
        set(_text "// Generated by cmake/Siblings.cmake -- do not edit.\n#include \"${_target}\"\n")
        if(EXISTS "${_out}")
            file(READ "${_out}" _old)
        else()
            set(_old "")
        endif()
        if(NOT _old STREQUAL _text)   # rewrite only on change: no rebuild storm
            file(WRITE "${_out}" "${_text}")
        endif()
    endforeach()
endfunction()

docboss_forward(mdboss "${MDBOSS_APP}"
    "${MDBOSS_CORE_UNITS};${MDBOSS_GUI_UNITS};${MDBOSS_HEADER_ONLY}")
docboss_forward(pdfboss "${PDFBOSS_APP}"
    "${PDFBOSS_CORE_UNITS};${PDFBOSS_GUI_UNITS}")

function(docboss_sources out app_dir units)
    set(_list "")
    foreach(_unit ${units})
        list(APPEND _list "${app_dir}/${_unit}.cpp")
    endforeach()
    set(${out} "${_list}" PARENT_SCOPE)
endfunction()

docboss_sources(MDBOSS_CORE_SOURCES "${MDBOSS_APP}" "${MDBOSS_CORE_UNITS}")
docboss_sources(MDBOSS_GUI_SOURCES "${MDBOSS_APP}" "${MDBOSS_GUI_UNITS}")
docboss_sources(PDFBOSS_CORE_SOURCES "${PDFBOSS_APP}" "${PDFBOSS_CORE_UNITS}")
docboss_sources(PDFBOSS_GUI_SOURCES "${PDFBOSS_APP}" "${PDFBOSS_GUI_UNITS}")

